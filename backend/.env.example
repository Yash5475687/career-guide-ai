# Career Guide AI — backend environment variables
# Copy this file to .env and fill in real values for production use.

PORT=4000

# Used to sign session tokens. Change this to a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-string

# --- Email provider (for real OTP delivery) -------------------------------
# Career Guide AI ships with a safe DEV AUTH MODE that does not require any
# of the variables below: verification codes are returned directly in the
# API response and printed to the server console, so you can test the full
# auth flow locally without sending real email.
#
# To send REAL emails in production, set AUTH_MODE=live and provide
# credentials for one of the supported providers.

AUTH_MODE=dev
# AUTH_MODE=live

# Example using Resend (https://resend.com) — swap for any provider by
# editing src/services/emailProvider.js
RESEND_API_KEY=
EMAIL_FROM=Career Guide AI <noreply@yourdomain.com>

# --- AI Mentor provider -----------------------------------------------------
# If ANTHROPIC_API_KEY is not set, the AI Mentor falls back to a realistic
# rule-based response engine (src/services/aiFallback.js) so the product
# still works end to end with zero external configuration.
ANTHROPIC_API_KEY=
